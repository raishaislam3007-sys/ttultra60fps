@app.post("/process")
async def process_video(request: Request, file: UploadFile = File(...)):
    unlocked = request.cookies.get("unlocked", "false") == "true"
    render_count = int(request.cookies.get("render_count", "0"))
    
    if not unlocked and render_count >= MAX_FREE_RENDERS:
        return HTMLResponse(content="<h3>Free limit reached! Please unlock unlimited access via WhatsApp.</h3><a href='/'>Go Back</a>", status_code=403)
    
    # Save uploaded file temporarily
    input_path = f"temp_{uuid.uuid4()}_{file.filename}"
    output_path = f"processed_{uuid.uuid4()}_{file.filename}"
    
    try:
        with open(input_path, "wb") as buffer:
            buffer.write(await file.read())
            
        # Run FFmpeg processing (example: scale or basic transcode)
        cmd = ["ffmpeg", "-i", input_path, "-vf", "scale=1280:720", output_path]
        subprocess.run(cmd, check=True)
        
        # Increment render count if not unlocked
        new_render_count = render_count + 1 if not unlocked else render_count
        
        from fastapi.responses import FileResponse
        response = FileResponse(output_path, media_type="video/mp4", filename="processed_video.mp4")
        response.set_cookie(key="render_count", value=str(new_render_count))
        return response
        
    except Exception as e:
        return JSONResponse(status_code=500, content={"error": str(e)})
    finally:
        # Cleanup input file
        if os.path.exists(input_path):
            os.remove(input_path)
